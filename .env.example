EXPORTER_URL=http://localhost:8000/metrics
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_ID=2jciebu_01
# MQTT_TOPICは既定でDEVICE_IDから sensors/2jciebu/<DEVICE_ID>/state として
# 自動導出される(スクリプト側のデフォルト展開。ここで${DEVICE_ID}のような
# 変数展開を書いても systemd の EnvironmentFile= では展開されないので注意)。
# 明示的に固定したい場合のみ、実際の値でコメントアウトを外して指定すること。
#MQTT_TOPIC=sensors/2jciebu/2jciebu_01/state
